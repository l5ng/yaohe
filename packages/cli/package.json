{
  "name": "@l5ng/yaohe",
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/l5ng/yaohe.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "bin": {
    "yaohe": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json --noEmit && tsdown && mkdir -p templates && cp ../core/templates/default.*.md templates/"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "cordis": "^3.18.1",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@l5ng/yaohe-collector-git": "workspace:*",
    "@l5ng/yaohe-collector-sessions": "workspace:*",
    "@l5ng/yaohe-core": "workspace:*",
    "@l5ng/yaohe-generator-claude": "workspace:*",
    "@l5ng/yaohe-generator-codex": "workspace:*",
    "tsdown": "^0.22.14"
  }
}
